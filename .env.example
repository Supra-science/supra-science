# Gmail API (OAuth2) for website contact + booking notifications (free, no card).
# The owner provides these via the secure vault; they are set with `wrangler secret put` on Cloudflare.
# The Nov-5 SMTP/App-Password transport was replaced by the Gmail API in Nov-8.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Sender Gmail address (defaults to the Gmail account above when unset)
GMAIL_SENDER=
# Google Calendar for consultation bookings (Meet links + invitations).
# Same OAuth client as Gmail; needs the Calendar scope on the refresh token.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# reCAPTCHA v3 secret key (server-side verification of the contact form)
RECAPTCHA_SECRET_KEY=
# Official business inbox (notifications are delivered here)
BUSINESS_EMAIL=Supra-science@proton.me
# AI providers (server-side only) — tried in this order:
# 1. Cloudflare Workers AI binding `AI` (no key needed)
# 2. Google Gemini (GEMINI_API_KEY), model gemini-3.8-flash
# 3. OpenAI (OPENAI_API_KEY), model gpt-4o-mini
# 4. Local rule-based answers from the service catalog (no key needed)
GEMINI_API_KEY=
OPENAI_API_KEY=
# WhatsApp Business Cloud API (server-side only)
# Get these from the Meta developer dashboard; never expose in client code.
WHATSAPP_ACCESS_TOKEN=
